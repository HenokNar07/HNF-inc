# FRED API key for the live 3-month T-bill risk-free rate.
# Get one free at https://fred.stlouisfed.org/docs/api/api_key.html
# If unset, math_engine.risk_free falls back to a hardcoded approximate rate.
FRED_API_KEY=

# Used later by the AI explanation layer (Claude), not by the math engine.
ANTHROPIC_API_KEY=
